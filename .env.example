# Claude-Proxy router settings.
# Copy this file to .env (next to router.js) and edit it. Never commit .env.
# Lines starting with # are ignored; commented-out options use their default.

# ---------- server ----------
# Port the router listens on (Claude Code's ANTHROPIC_BASE_URL points here).
PORT=4000
# 0.0.0.0 = all interfaces, 127.0.0.1 = this PC only, or your Tailscale IP = tailnet only.
HOST=0.0.0.0

# ---------- llama-server ----------
# llama-server's OpenAI endpoint. Use 127.0.0.1, not localhost (localhost can resolve to IPv6 ::1).
TARGET_BASE=http://127.0.0.1:8805/v1
# Required. Name sent upstream and shown in Claude Code; llama-server serves one model, so any label works.
LOCAL_MODEL=your-model-name
# Health endpoint polled while the model loads. Default: TARGET_BASE without /v1, plus /health.
#HEALTH_URL=http://127.0.0.1:8805/health
# How long a request waits for the model to finish loading, in ms (default 600000 = 10 min).
#LOAD_WAIT_MS=600000

# ---------- auth ----------
# Must equal ANTHROPIC_AUTH_TOKEN in Claude Code's settings.json. Leave empty to disable auth.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_KEY=PutYourGeneratedTokenHere
# Paths answered with 200 without auth (comma separated).
PUBLIC_PATHS=/api/hello,/health

# ---------- features (on unless set to 0) ----------
# Send every tool seen so far with every request, so MCP servers connecting late don't change the prompt prefix.
#TOOL_SUPERSET=1
# Show "Loading model" / "Reading prompt" progress in Claude Code's thinking block (Ctrl+O).
#SHOW_PROGRESS=1
# Save slot 0 to SLOT_FILE after the prompt prefix changes (needs llama-server --slot-save-path).
#AUTO_SAVE=1
# Restore SLOT_FILE into slot 0 when the router starts and after llama-server restarts.
#AUTO_RESTORE=1

# ---------- snapshot ----------
# Snapshot file name (not a path), stored in llama-server's --slot-save-path folder.
#SLOT_FILE=warm.bin
# Snapshots holding fewer cached tokens than this are not kept.
#AUTO_SAVE_MIN_TOKENS=8000

# ---------- misc ----------
# Folder for the router's own files (known-tools.json, fingerprints log, snapshot.json). Relative to router.js.
#DATA_DIR=router-data
# Heartbeat interval in ms while the model reads the prompt.
#PING_MS=5000
# 1 = log raw upstream payloads.
DEBUG=0
